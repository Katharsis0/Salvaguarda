#!/bin/bash
# Low / full battery notifications (run every 5 min from i3/config).
# Reads UPower's combined laptop battery (DisplayDevice): the same number the
# polybar module and battery_guard show. It covers both T480 batteries
# weighted by their size, and ignores Bluetooth devices. (The old version
# averaged every line of `acpi -b`, which included the keyboard's battery, so
# it said 15% while the real charge was 22%.)
# The last-minute countdown + hibernate at 5% is battery_guard; this is the
# earlier heads-up.

export DISPLAY=${DISPLAY:-:0}
export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/$(id -u)/bus}

WARNING_LEVEL=15
EMPTY_FILE=/tmp/batteryempty
FULL_FILE=/tmp/batteryfull

INFO=$(upower -i "$(upower -e | grep -m1 DisplayDevice)" 2>/dev/null) || exit 0
PCT=$(awk '/percentage:/ {gsub("%", "", $2); printf "%d", $2 + 0.5}' <<<"$INFO")
STATE=$(awk '/state:/ {print $2}' <<<"$INFO")
LEFT=$(awk '/time to empty:/ {print $4, $5}' <<<"$INFO")
[ -n "$PCT" ] || exit 0

# Reset notification states
if [ "$STATE" != discharging ]; then rm -f "$EMPTY_FILE"; else rm -f "$FULL_FILE"; fi

if [ "$STATE" != discharging ] && [ "$PCT" -ge 96 ] && [ ! -f "$FULL_FILE" ]; then
    notify-send "Battery Charged" "Battery is fully charged." -i battery -r 9991
    touch "$FULL_FILE"
elif [ "$STATE" = discharging ] && [ "$PCT" -le "$WARNING_LEVEL" ] && [ ! -f "$EMPTY_FILE" ]; then
    notify-send "Low Battery" "${PCT}% remaining${LEFT:+ (about $LEFT)}. Plug in the charger." \
        -u critical -i battery-caution -r 9991
    touch "$EMPTY_FILE"
fi

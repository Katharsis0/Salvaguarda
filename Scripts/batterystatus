#!/bin/bash
# Polybar battery module.
#   plugged in : 󰂄 87%            (charging icon, no time estimate)
#   plugged, held at the 80% care limit: 󰚥 80%   (plug icon: not charging on purpose)
#   click: toggle the care limit / one full charge (Scripts/battery_charge.sh)
#   on battery : 󰁿 54%  2h 13m    (level icon + time until empty; red when low)
# Uses upower's combined DisplayDevice, so the T480's two batteries are
# weighted by capacity instead of naively averaged.

DEV=$(upower -e | grep -m1 DisplayDevice)
read -r STATE PCT HOURS < <(upower -i "$DEV" | awk '
    /^ *state:/      { st=$2 }
    /^ *percentage:/ { gsub(/%/,"",$2); pct=int($2+0.5) }
    /^ *time to empty:/ {
        v=$4; u=$5; gsub(",",".",v)
        if (u ~ /hour/) h=v; else if (u ~ /minute/) h=v/60; else if (u ~ /second/) h=v/3600
    }
    END { if (h=="") h=-1; print st, pct, h }')

AC=0
for s in /sys/class/power_supply/A{C,DP}*/online; do
    [ -r "$s" ] && [ "$(cat "$s")" = 1 ] && AC=1
done
[ "$STATE" = discharging ] || AC=1   # charging / fully-charged / pending-charge

if [ "$(cat "$HOME/.cache/theme_mode" 2>/dev/null)" = light ]; then
    ALERT="#C0392B"; OK="#2B7A72"      # bone palette (polybar/colors-light.ini)
else
    ALERT="#A54242"; OK="#8ABEB7"
fi

if [ "$AC" = 1 ]; then
    END=$(cat /sys/class/power_supply/BAT0/charge_control_end_threshold 2>/dev/null || echo 100)
    if [ "$STATE" != charging ] && (( END < 100 )); then
        echo "%{F$OK}󰚥%{F-} ${PCT}%"          # plugged in, holding at the care limit
    else
        echo "%{F$OK}󰂄%{F-} ${PCT}%"
    fi
    exit 0
fi

ICONS=(󰂎 󰁺 󰁻 󰁼 󰁽 󰁾 󰁿 󰂀 󰂁 󰂂 󰁹)
ICON=${ICONS[$(( PCT / 10 ))]}

TIME=""
if awk -v h="$HOURS" 'BEGIN{exit !(h > 0)}'; then
    # "1h 12m" / "45m": an h:mm here looked like a second clock next to the real one
    TIME=$(awk -v h="$HOURS" 'BEGIN{m=int(h*60+0.5); if (m >= 60) printf "  %dh %02dm", m/60, m%60; else printf "  %dm", m}')
fi

if (( PCT <= 15 )); then
    echo "%{F$ALERT}$ICON ${PCT}%$TIME%{F-}"
else
    echo "$ICON ${PCT}%$TIME"
fi
